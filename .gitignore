# ---------------------------------------------------------------------
# Unity — generated folders
# These are rebuilt by the editor. Committing them causes merge hell and
# blows past GitHub's file size limits.
# ---------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset Store tools
[Aa]ssets/AssetStoreTools*

# Recorder output
[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------
# Office lock files (Word leaves these next to open .docx briefs)
# ---------------------------------------------------------------------
~$*
.~lock.*

# ---------------------------------------------------------------------
# Course-specific
# Raw participant data may contain identifying info. Keep the folder
# structure, review before committing anything into it.
# ---------------------------------------------------------------------
testing-data/**/raw-private/
